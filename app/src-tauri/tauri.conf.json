{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songbe",
  "version": "../../package.json",
  "identifier": "app.songbe.studio",
  "build": { "frontendDist": "../splash" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/core/": "core/", "resources/licenses/": "licenses/" },
    "externalBin": ["binaries/songbe-engine"],
    "publisher": "Songbe",
    "category": "Video",
    "shortDescription": "Films, series and short ads made with AI",
    "longDescription": "Songbe makes a series from an idea — the script, the cast with their faces and voices, every shot, every episode — on a canvas where each piece can be changed, and turns one description file into a finished short ad.",
    "copyright": "Copyright © 2026 Le Hieu. All rights reserved.",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "sidebarImage": "installer/sidebar.bmp", "headerImage": "installer/header.bmp" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "depends": ["ffmpeg"] }
    }
  }
}
